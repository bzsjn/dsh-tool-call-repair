{
  "name": "dsh-tool-call-repair",
  "version": "0.6.0",
  "description": "Keeps a turn alive and honest: recoverable request failures retry with exponential backoff under a bounded budget, empty completions become a retryable EMPTY_RESPONSE instead of a silent empty answer, degenerate filler loops in the reasoning stream are truncated and resumed, and content-less assistant messages are filtered out of the outgoing history — so transient gateway faults, zero-content responses, reasoning loops and polluted history no longer end the task.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    ".build",
    "src",
    "tsconfig.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "tool-call",
    "retry",
    "malformed-response",
    "empty-response",
    "degenerate-loop",
    "history-clean"
  ],
  "icon": "./icon.svg",
  "license": "MIT",
  "author": "bzsjn",
  "homepage": "https://github.com/bzsjn/dsh-tool-call-repair#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bzsjn/dsh-tool-call-repair.git"
  },
  "bugs": {
    "url": "https://github.com/bzsjn/dsh-tool-call-repair/issues"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.1-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:lib": "node scripts/build-lib.mjs",
    "build:lib:check": "node scripts/build-lib.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node tests/stream-repair.mjs && node tests/degenerate.mjs && node tests/history-clean.mjs && node tests/scoped-provider.mjs",
    "index": "node scripts/build-index.mjs",
    "index:check": "node scripts/build-index.mjs --check",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
