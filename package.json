{
  "name": "dsh-tool-call-repair",
  "version": "0.4.3",
  "description": "Keeps a turn alive when a model request fails recoverably: any failure code is retried with exponential backoff under a bounded budget, so transient gateway faults (truncated tool arguments, empty completions, early stream ends) do not end the task. Toggleable from the plugin manager.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "src",
    "tsconfig.json",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "tool-call",
    "retry",
    "malformed-response"
  ],
  "icon": "./icon.svg",
  "license": "MIT",
  "author": "bzsjn",
  "homepage": "https://github.com/bzsjn/dsh-tool-call-repair#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bzsjn/dsh-tool-call-repair.git"
  },
  "bugs": {
    "url": "https://github.com/bzsjn/dsh-tool-call-repair/issues"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.1-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "index": "node scripts/build-index.mjs",
    "index:check": "node scripts/build-index.mjs --check"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
